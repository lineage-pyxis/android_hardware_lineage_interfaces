cc_binary {
    name: "vendor.lineage.fastcharge@1.0-service.default",
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "FastCharge.cpp",
        "service.cpp",
    ],
    cppflags: select(soong_config_variable("fastcharge", "default_config"), {
        "false": ["-DFASTCHARGE_DEFAULT_SETTING=false"],
        default: ["-DFASTCHARGE_DEFAULT_SETTING=true"],
    }) + select(soong_config_variable("fastcharge", "enabled_value"), {
        any @ flag_val: ["-DFASTCHARGE_ENABLED_VALUE=flag_val"],
        default: ["-DFASTCHARGE_ENABLED_VALUE=0"],
    }) + select(soong_config_variable("fastcharge", "path"), {
        any @ flag_val: ["-DFASTCHARGE_PATH=\"" + flag_val + "\""],
        default: [],
    }),
    init_rc: ["vendor.lineage.fastcharge@1.0-service.default.rc"],
    vintf_fragments: ["vendor.lineage.fastcharge@1.0-service.default.xml"],
    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "libhidlbase",
        "libutils",
        "vendor.lineage.fastcharge@1.0",
    ],
}
